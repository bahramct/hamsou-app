# ─────────────────────────────────────────────────────────────────────────────
# .env.example — همسو
# این فایل الگوست. مقادیر واقعی را در .env.local قرار بده (که در .gitignore است).
# ─────────────────────────────────────────────────────────────────────────────

# ─── App Mode (CLAUDE.md §۱۳) ─────────────────────────────────────────────────
# تعیین می‌کند اپلیکیشن در dev هست یا prod.
# مقادیر مجاز: "development" | "production"
# هر مقدار دیگری (یا خالی) به‌صورت "production" تفسیر می‌شود (fail-safe).
NEXT_PUBLIC_APP_MODE="development"

# Database (SQLite در فاز MVP)
DATABASE_URL="file:./dev.db"

# Auth / Session
NEXTAUTH_SECRET="please-generate-a-strong-random-string"

# ─── AI Services (DECISION-039 + DECISION-048) ───────────────────────────────
# روتینگ AI دیگر env-محور نیست. سرویس‌ها (آدرس/کلید/مدل) در پنل ادمین تعریف
# و در DB (AiService) ذخیره می‌شوند؛ resolve بر اساس منطقهٔ کاربر + اتصال بخش‌ها،
# با fallback سراسری به تنها سرویس فعال. «mock» کاملاً حذف شده — فقط سرویس واقعی.
# متغیرهای GAPGPT_*/OPENAI_* فقط برای factoryِ by-name (لگاسی) باقی مانده‌اند و
# در مسیر اجراییِ فعلی استفاده نمی‌شوند (مقدار واقعی از ردیف سرویس در DB می‌آید).
# GAPGPT_BASE_URL="https://api.gapgpt.app/v1"
# GAPGPT_API_KEY=""
# GAPGPT_MODEL="gpt-4o-mini"

# SMS Adapter (mock | smsir)
SMS_PROVIDER="mock"
SMS_API_KEY=""

# sms.ir — فقط وقتی SMS_PROVIDER="smsir" است لازم می‌شوند.
# sandbox و production یک endpoint دارند؛ برای محیط واقعی فقط کلید/قالب را عوض کن.
# SMSIR_API_KEY=""              # کلید وب‌سرویس (sandbox یا production)
# SMSIR_TEMPLATE_ID=""         # شناسهٔ قالبِ «کد تأیید» در پنل sms.ir
# SMSIR_PARAM_NAME="Code"      # نام پارامتر داخل قالب (اختیاری — پیش‌فرض Code)
# SMSIR_BASE_URL="https://api.sms.ir/v1"  # اختیاری

# ─── Email (Resend) — DECISION-064 ────────────────────────────────────────────
# سرویس‌دهندهٔ ایمیل برای ارسال ایمیل تأیید، بازیابی رمز و سایر ایمیل‌های سیستمی.
# کلید از resend.com دریافت می‌شود. از پنل ادمین (/admin/email) هم قابل تنظیم است.
# EMAIL_RESEND_API_KEY=""           # کلید API از resend.com
# EMAIL_FROM_ADDRESS="noreply@hamsouapp.ir"   # دامنهٔ تأییدشده (هم dev هم production)
# EMAIL_FROM_NAME="همسو"            # نام فرستنده

# کارت مرجعِ دریافت پرداخت (DECISION-062) — برای seed اولیهٔ کیف‌پول.
# بعد از seed از پنل ادمین (پرداخت) قابل ویرایش است؛ اینجا فقط مقدار اولیه.
# PAYMENT_CARD_NUMBER=""        # ۱۶ رقم بدون فاصله
# PAYMENT_CARD_HOLDER=""        # نام صاحب کارت
# PAYMENT_CARD_BANK=""          # نام بانک

# Business rules
OTP_EXPIRY_MINUTES=5
ENTRY_EDIT_WINDOW_HOURS=2

# Next.js
NEXT_PUBLIC_APP_NAME="Hamsoo"

# ─── آدرس پایهٔ اپ (DECISION-052) ────────────────────────────────────────────
# فقط برای متادیتای سمت سرور (OG image / metadataBase صفحهٔ اشتراک‌گذاری) لازم است.
# لینک‌هایی که کاربر می‌بیند/کپی می‌کند روی کلاینت از window.location.origin ساخته
# می‌شوند، پس برای آن‌ها هیچ env لازم نیست. با مهاجرت local→server فقط همین مقدار
# را به دامنهٔ واقعی تغییر بده — هیچ سورسی دستکاری نمی‌شود.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
